		"concurrently": "^9.2.1",
		"electron": "^43.3.0",
		"electron-builder": "^26.15.3",
		"knip": "^5.82.1",
		"lefthook": "^2.0.15",
		"oxfmt": "^0.26.0",
		"oxlint": "^1.41.0",
		"typescript": "^5.9.3"
	},
	"overrides": {
