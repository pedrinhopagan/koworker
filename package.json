{
	"name": "koworker",
	"version": "0.1.0",
	"private": true,
	"description": "Koworker - ERP full-stack brasileiro com projetos e tarefas para AI Coding Agents",
	"homepage": "https://github.com/pedrinhopagan/koworker",
	"license": "UNLICENSED",
	"author": {
		"name": "pedrinhopagan",
		"email": "pedrinhopagan@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/pedrinhopagan/koworker.git"
	},
	"bin": {
		"kw-cli": "./src/cli/index.ts"
	},
	"type": "module",
	"main": "electron/out/main.cjs",
	"scripts": {
		"setup": "bun run scripts/setup.ts",
		"dev": "bun run electron:build && concurrently -k --success first 'tsr watch' 'electron . --show'",
		"dev:electron": "bun run dev",
		"dev:web": "concurrently 'tsr watch' 'bun --watch src/server.ts'",
		"build:web": "bun run scripts/desktop/build-web.ts",
		"build:backend": "bun run scripts/desktop/build-backend.ts",
		"electron:build": "bun run scripts/desktop/build-electron.ts",
		"desktop:prepare": "NODE_ENV=production bun run electron:build && bun run build:web && bun run build:backend",
		"desktop:pack": "bun run desktop:prepare && electron-builder --dir",
		"desktop:build": "bun run desktop:prepare && bun run scripts/desktop/build-packages.ts",
		"desktop:update": "bash ./scripts/desktop/update-and-build.sh",
		"deploy": "bun run scripts/desktop/deploy.ts",
		"deploy:fast": "bun run scripts/desktop/hot-deploy.ts",
		"cli": "bun run src/cli/index.ts",
		"oxlint": "oxlint src scripts electron --ignore-pattern='*.gen.ts'",
		"typecheck": "tsc --noEmit",
		"test": "bun run scripts/test.ts",
		"check": "bun run typecheck && bun run oxlint && bun run test",
		"seed": "bun run scripts/seed.ts"
	},
	"dependencies": {
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.2.2",
		"@lezer/common": "^1.5.2",
		"@lezer/highlight": "^1.2.3",
		"@lezer/markdown": "^1.6.3",
		"@lobomfz/db": "^0.1.0",
		"@orpc/client": "^1.13.4",
		"@orpc/experimental-publisher": "^1.13.4",
		"@orpc/server": "^1.13.4",
		"@orpc/tanstack-query": "^1.13.4",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-context-menu": "^2.2.16",
		"@radix-ui/react-dialog": "^1.1.18",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
