{
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"electron/**/*.ts",
		"scripts/**/*.ts",
		"tests/**/*.ts",
		"tests/**/*.tsx"
	],
	"exclude": ["workopilot-front-end", "node_modules", "dist", "electron/out", "electron/release"],
	"compilerOptions": {
		"target": "ESNext",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["bun"],

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,

		"skipLibCheck": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
