DATABASE_URL="/home/pedro/.local/share/com.pedro.kowork/kowork.db"
JWT_SECRET="your-secret-here"
KOWORK_ADMIN_USER="pedro"
KOWORK_ADMIN_PASSWORD="troque-esta-senha"
# Porta do servidor. NÃO defina em dev (dev usa 2841, prod usa 2842 automaticamente via Tauri).
# KOWORK_PORT=2842
# KOWORK_ALLOWED_ORIGINS="https://outro-dominio.example"
# KOWORK_NOTIFY_TOKEN="token-secreto-para-cli-notify"
# KOWORK_REPO_DIR="/mnt/data/Projects/koworker"
# Push do PWA. Gere o par com `bun -e 'import w from "web-push"; console.log(w.generateVAPIDKeys())'`.
# Sem as duas chaves o backend não envia push (a central e o alerta in-app continuam funcionando).
# KOWORK_VAPID_PUBLIC_KEY="..."
# KOWORK_VAPID_PRIVATE_KEY="..."
# KOWORK_VAPID_SUBJECT="https://pc-casa.tail1cdea8.ts.net"
